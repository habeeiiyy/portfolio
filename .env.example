# Portfolio configuration
# Copy this file to `.env` and fill in your own values.
# NOTE: This is a static HTML site served directly (e.g. GitHub Pages).
# Configuration values are mirrored in assets/js/config.js (window.PORTFOLIO_CONFIG).
#
# CONTACT PRIVACY NOTE:
# A standard WhatsApp direct-chat link (https://wa.me/<number>) inherently exposes
# the recipient's phone number to anyone inspecting the link or browser network tab.
# To protect your personal phone number from public exposure:
# 1. Leave WHATSAPP_LINK empty to keep the button in configuration mode,
#    which safely directs visitors to your contact form and email.
# 2. Or supply a dedicated WhatsApp Business number or shortlink if you wish
#    to enable direct WhatsApp messaging.

# WhatsApp configuration (Leave empty for privacy mode, or supply your link)
WHATSAPP_LINK=

# Email
CONTACT_EMAIL=habeebdeveloper.india@gmail.com
MAILTO_LINK=mailto:habeebdeveloper.india@gmail.com

# Form backend (contact form action)
FORM_ACTION=https://formsubmit.co/ajax/habeebdeveloper.india@gmail.com

# Site
SITE_NAME=Habeeb P
SITE_URL=https://habeeiiyy.in
